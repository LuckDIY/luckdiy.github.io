---
import Layout from '~/layouts/Layout.astro'

const btn =
  'text-xs sm:text-sm text-accent border-1 border-accent/40 rounded-lg px-2.5 py-1 hover:bg-accent/10 active:bg-accent/20 transition-colors cursor-pointer'
const btnDanger =
  'text-xs sm:text-sm text-red border-1 border-red/40 rounded-lg px-2.5 py-1 hover:bg-red/10 active:bg-red/20 transition-colors cursor-pointer'
const divider = 'inline-block w-px h-5 bg-foreground/20 mx-1'
---

<Layout
  title="JSON 格式化"
  description="在线 JSON 美化、压缩、校验、转义、Unicode 互转、可折叠"
  fullHeight={true}
  hiddeFooter={true}
>
  <section class="mt-3 flex flex-col gap-3 flex-1 min-h-0 overflow-hidden">
    <!-- 工具栏 -->
    <div
      class="flex flex-wrap items-center gap-1.5 p-2 rounded-xl border-1 border-accent/30 bg-accent/5"
    >
      <button data-act="format" class={btn}>校验 / 格式化</button>
      <button data-act="minify" class={btn}>压缩</button>
      <span class={divider}></span>
      <button data-act="escape" class={btn}>转义</button>
      <button data-act="unescape" class={btn}>去转义</button>
      <span class={divider}></span>
      <button data-act="u2c" class={btn}>Unicode → 中文</button>
      <button data-act="c2u" class={btn}>中文 → Unicode</button>
      <span class={divider}></span>
      <button data-act="expand" class={btn}>展开全部</button>
      <button data-act="collapse" class={btn}>折叠全部</button>
      <label class="flex items-center gap-1.5 text-xs px-1.5 text-foreground/80">
        缩进
        <select
          id="indent"
          class="bg-transparent border-1 border-foreground/30 rounded px-1 py-0.5 text-xs"
        >
          <option value="2">2</option>
          <option value="4">4</option>
          <option value="\t">Tab</option>
        </select>
      </label>
      <div class="flex-1"></div>
      <button data-act="copy" class={btn}>复制</button>
      <button data-act="download" class={btn}>下载</button>
      <button data-act="clear" class={btnDanger}>清空</button>
    </div>

    <!-- 单一可编辑视图：格式化后是带颜色和折叠箭头的多行结构，直接点击就能改 -->
    <div
      id="editor"
      contenteditable="plaintext-only"
      spellcheck="false"
      autocapitalize="off"
      autocorrect="off"
      data-placeholder='在这里粘贴 JSON，例如：{"name":"张三","age":18}，然后点 校验/格式化'
      class="flex-1 min-h-0 border-1 border-accent/30 rounded-xl bg-foreground/[0.02] p-3 font-mono text-sm overflow-auto outline-none focus:border-accent transition-colors"
    ></div>

    <!-- 状态栏 -->
    <div
      class="flex flex-wrap items-center gap-x-4 gap-y-1 px-3 py-2 rounded-xl border-1 border-accent/20 bg-accent/5 text-xs font-mono"
    >
      <span id="status" class="flex-1 min-w-0 truncate" aria-live="polite">
        <span class="text-foreground/60"
          >就绪。Ctrl/⌘ + Enter 一键格式化，点 ▼/▶ 折叠对象/数组。</span
        >
      </span>
      <span class="text-foreground/60"
        >行 <span id="stat-lines" class="text-foreground">1</span></span
      >
      <span class="text-foreground/60"
        >字符 <span id="stat-chars" class="text-foreground">0</span></span
      >
      <span class="text-foreground/60"
        >字节 <span id="stat-bytes" class="text-foreground">0</span></span
      >
    </div>
  </section>
</Layout>

<style>
  /* 空内容时显示 placeholder */
  :global(#editor:empty::before) {
    content: attr(data-placeholder);
    color: color-mix(in srgb, var(--theme-foreground) 40%, transparent);
    pointer-events: none;
  }

  :global(#editor) {
    counter-reset: line;
  }
  :global(#editor .line) {
    display: block;
    line-height: 1.6;
    white-space: pre;
    min-height: 1.6em;
    position: relative;
    padding-left: 4rem;
    counter-increment: line;
  }
  :global(#editor .line::before) {
    content: counter(line);
    position: absolute;
    left: 0;
    top: 0;
    width: 2.5rem;
    text-align: right;
    color: color-mix(in srgb, var(--theme-foreground) 45%, transparent);
    user-select: none;
    pointer-events: none;
    font-variant-numeric: tabular-nums;
  }
  :global(#editor .line.fold-hidden) {
    display: none;
  }

  :global(.fold-toggle) {
    cursor: pointer;
    user-select: none;
    color: var(--theme-accent);
    position: absolute;
    left: 2.7rem;
    top: 0;
    width: 1.1rem;
    text-align: center;
    border-radius: 4px;
  }
  :global(.fold-toggle:hover) {
    background: color-mix(in srgb, var(--theme-accent) 20%, transparent);
  }
  :global(.fold-summary) {
    color: color-mix(in srgb, var(--theme-foreground) 55%, transparent);
    user-select: none;
    margin-left: 0.25rem;
  }

  :global(.tv-key) {
    color: var(--theme-magenta);
  }
  :global(.tv-str) {
    color: var(--theme-green);
  }
  :global(.tv-num) {
    color: var(--theme-blue);
  }
  :global(.tv-bool) {
    color: var(--theme-yellow);
  }
  :global(.tv-null) {
    color: var(--theme-foreground);
    opacity: 0.6;
  }
</style>

<script>
  const editor = document.getElementById('editor') as HTMLDivElement
  const status = document.getElementById('status') as HTMLSpanElement
  const indentSel = document.getElementById('indent') as HTMLSelectElement
  const statLines = document.getElementById('stat-lines')!
  const statChars = document.getElementById('stat-chars')!
  const statBytes = document.getElementById('stat-bytes')!

  type Tone = 'ok' | 'err' | 'info'
  const setStatus = (msg: string, tone: Tone = 'info') => {
    const color =
      tone === 'ok'
        ? 'var(--theme-green)'
        : tone === 'err'
          ? 'var(--theme-red)'
          : 'var(--theme-foreground)'
    status.innerHTML = `<span style="color:${color}">${msg}</span>`
  }

  const getIndent = (): string => {
    const v = indentSel.value
    if (v === '\\t') return '\t'
    return ' '.repeat(Number(v))
  }

  const escapeHtml = (s: string) =>
    s.replace(
      /[&<>"']/g,
      (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!,
    )

  const valueHtml = (v: any): string => {
    if (v === null) return `<span class="tv-null">null</span>`
    if (typeof v === 'string') return `<span class="tv-str">"${escapeHtml(v)}"</span>`
    if (typeof v === 'number') return `<span class="tv-num">${v}</span>`
    if (typeof v === 'boolean') return `<span class="tv-bool">${String(v)}</span>`
    return escapeHtml(String(v))
  }

  // === 取得当前编辑器中的纯 JSON 文本 ===
  // 折叠摘要带 data-skip 属性，提取时跳过
  const getRawText = (): string => {
    // 如果是格式化后的结构 (有 .line)，按行拼
    if (editor.querySelector('.line')) {
      let out = ''
      editor.querySelectorAll<HTMLDivElement>('.line').forEach((line, idx) => {
        if (idx > 0) out += '\n'
        out += extractText(line)
      })
      return out
    }
    return editor.textContent || ''
  }

  const extractText = (node: Node): string => {
    if (node.nodeType === Node.TEXT_NODE) return node.textContent || ''
    if (node.nodeType !== Node.ELEMENT_NODE) return ''
    const el = node as HTMLElement
    if (el.dataset.skip === 'true') return '' // 折叠摘要、折叠按钮跳过
    let out = ''
    el.childNodes.forEach((c) => (out += extractText(c)))
    return out
  }

  const updateStats = () => {
    const text = getRawText()
    statChars.textContent = String(text.length)
    statBytes.textContent = String(new Blob([text]).size)
    const visibleLines = editor.querySelectorAll('.line:not(.fold-hidden)').length
    statLines.textContent = String(
      visibleLines || (text ? text.split('\n').length : 1),
    )
  }

  editor.addEventListener('input', updateStats)
  updateStats()

  // === 渲染：递归生成扁平 .line 节点 ===
  const buildLines = (
    value: any,
    depth: number,
    key: string | undefined,
    isLast: boolean,
    out: HTMLElement[],
    indent: string,
  ) => {
    const pad = indent.repeat(depth)
    const trailing = isLast ? '' : ','
    const keyHtml =
      key !== undefined
        ? `<span class="tv-key">"${escapeHtml(key)}"</span>: `
        : ''

    if (value === null || typeof value !== 'object') {
      const line = document.createElement('div')
      line.className = 'line'
      line.innerHTML = pad + keyHtml + valueHtml(value) + trailing
      out.push(line)
      return
    }

    const isArr = Array.isArray(value)
    const entries: [string, any][] = isArr
      ? (value as any[]).map((v, i) => [String(i), v])
      : Object.entries(value)
    const open = isArr ? '[' : '{'
    const close = isArr ? ']' : '}'

    if (entries.length === 0) {
      const line = document.createElement('div')
      line.className = 'line'
      line.innerHTML = pad + keyHtml + open + close + trailing
      out.push(line)
      return
    }

    // 起始行：缩进 + 键 + 折叠按钮 + 开括号 + 折叠摘要(初始隐藏)
    const startLine = document.createElement('div')
    startLine.className = 'line fold-start'
    startLine.innerHTML =
      pad +
      keyHtml +
      `<span class="fold-toggle" data-skip="true" data-collapsed="false" contenteditable="false">▼</span>` +
      open +
      `<span class="fold-summary" data-skip="true" contenteditable="false" style="display:none"> ... ${entries.length} ${isArr ? 'items' : 'keys'} ${close}${trailing}</span>`
    out.push(startLine)

    entries.forEach(([k, v], i) => {
      buildLines(
        v,
        depth + 1,
        isArr ? undefined : k,
        i === entries.length - 1,
        out,
        indent,
      )
    })

    const endLine = document.createElement('div')
    endLine.className = 'line fold-end'
    endLine.innerHTML = pad + close + trailing
    out.push(endLine)
  }

  const renderJSON = (value: any) => {
    const lines: HTMLElement[] = []
    buildLines(value, 0, undefined, true, lines, getIndent())
    editor.replaceChildren(...lines)
    bindFoldHandlers()
    updateStats()
  }

  // === 折叠/展开 ===
  const findMatchingEnd = (start: HTMLElement): HTMLElement | null => {
    let depth = 1
    let cur = start.nextElementSibling as HTMLElement | null
    while (cur) {
      if (cur.classList.contains('fold-start')) depth++
      if (cur.classList.contains('fold-end')) {
        depth--
        if (depth === 0) return cur
      }
      cur = cur.nextElementSibling as HTMLElement | null
    }
    return null
  }

  const setFolded = (toggleEl: HTMLElement, collapsed: boolean) => {
    toggleEl.dataset.collapsed = collapsed ? 'true' : 'false'
    toggleEl.textContent = collapsed ? '▶' : '▼'

    const startLine = toggleEl.closest('.line') as HTMLElement | null
    if (!startLine) return
    const summary = startLine.querySelector(
      '.fold-summary',
    ) as HTMLElement | null
    if (summary) summary.style.display = collapsed ? '' : 'none'
  }

  const applyFolds = () => {
    // 重置
    editor
      .querySelectorAll<HTMLElement>('.line.fold-hidden')
      .forEach((el) => el.classList.remove('fold-hidden'))

    // 按 DOM 顺序应用折叠（已被父级折叠的 toggle 跳过）
    editor
      .querySelectorAll<HTMLElement>('.fold-toggle[data-collapsed="true"]')
      .forEach((toggle) => {
        const startLine = toggle.closest('.line') as HTMLElement | null
        if (!startLine || startLine.classList.contains('fold-hidden')) return
        const endLine = findMatchingEnd(startLine)
        if (!endLine) return
        let cur = startLine.nextElementSibling as HTMLElement | null
        while (cur) {
          cur.classList.add('fold-hidden')
          if (cur === endLine) break
          cur = cur.nextElementSibling as HTMLElement | null
        }
      })

    updateStats()
  }

  const bindFoldHandlers = () => {
    editor.querySelectorAll<HTMLElement>('.fold-toggle').forEach((t) => {
      t.addEventListener('click', (e) => {
        e.preventDefault()
        e.stopPropagation()
        setFolded(t, t.dataset.collapsed !== 'true')
        applyFolds()
      })
    })
  }

  // === 错误定位 ===
  const positionToLineCol = (text: string, pos: number) => {
    const slice = text.slice(0, pos)
    const line = slice.split('\n').length
    const col = pos - slice.lastIndexOf('\n')
    return { line, col }
  }
  const parseError = (e: any, text: string): string => {
    const msg = (e && e.message) || String(e)
    const m = msg.match(/position\s+(\d+)/i)
    if (m) {
      const { line, col } = positionToLineCol(text, Number(m[1]))
      return `✗ ${msg}  →  第 ${line} 行第 ${col} 列`
    }
    return `✗ ${msg}`
  }

  const requireText = (): string | null => {
    const t = getRawText()
    if (!t.trim()) {
      setStatus('请先在编辑器内输入 JSON 文本', 'err')
      return null
    }
    return t
  }

  const setPlainText = (text: string) => {
    editor.replaceChildren(document.createTextNode(text))
    updateStats()
  }

  // === 操作 ===
  const actions: Record<string, () => void> = {
    format() {
      const t = requireText()
      if (t == null) return
      try {
        const parsed = JSON.parse(t)
        renderJSON(parsed)
        setStatus('✓ 格式化完成 — 点 ▼/▶ 折叠，直接点击文本可编辑', 'ok')
      } catch (e) {
        setStatus(parseError(e, t), 'err')
      }
    },
    minify() {
      const t = requireText()
      if (t == null) return
      try {
        const parsed = JSON.parse(t)
        setPlainText(JSON.stringify(parsed))
        setStatus('✓ 已压缩为单行', 'ok')
      } catch (e) {
        setStatus(parseError(e, t), 'err')
      }
    },
    escape() {
      const t = requireText()
      if (t == null) return
      setPlainText(JSON.stringify(t).slice(1, -1))
      setStatus('✓ 已转义', 'ok')
    },
    unescape() {
      const t = requireText()
      if (t == null) return
      try {
        const wrapped =
          '"' + t.replace(/\\"/g, '\\"').replace(/(?<!\\)"/g, '\\"') + '"'
        setPlainText(JSON.parse(wrapped))
        setStatus('✓ 已去除转义', 'ok')
      } catch (e: any) {
        setStatus(`✗ 无法去转义：${e.message}`, 'err')
      }
    },
    u2c() {
      const t = requireText()
      if (t == null) return
      const out = t.replace(/\\u([0-9a-fA-F]{4})/g, (_, hex) =>
        String.fromCharCode(parseInt(hex, 16)),
      )
      setPlainText(out)
      setStatus('✓ 已将 \\uXXXX 转为字符', 'ok')
    },
    c2u() {
      const t = requireText()
      if (t == null) return
      let out = ''
      for (const ch of t) {
        const code = ch.codePointAt(0)!
        if (code > 0x7f) {
          if (code > 0xffff) {
            const high = 0xd800 + ((code - 0x10000) >> 10)
            const low = 0xdc00 + ((code - 0x10000) & 0x3ff)
            out +=
              '\\u' +
              high.toString(16).padStart(4, '0') +
              '\\u' +
              low.toString(16).padStart(4, '0')
          } else {
            out += '\\u' + code.toString(16).padStart(4, '0')
          }
        } else {
          out += ch
        }
      }
      setPlainText(out)
      setStatus('✓ 已将非 ASCII 字符转为 \\uXXXX', 'ok')
    },
    expand() {
      const toggles = editor.querySelectorAll<HTMLElement>(
        '.fold-toggle[data-collapsed="true"]',
      )
      if (toggles.length === 0) {
        setStatus('当前没有折叠的节点（先点 校验/格式化）', 'info')
        return
      }
      toggles.forEach((t) => setFolded(t, false))
      applyFolds()
      setStatus('✓ 已展开全部节点', 'ok')
    },
    collapse() {
      const toggles = editor.querySelectorAll<HTMLElement>(
        '.fold-toggle[data-collapsed="false"]',
      )
      if (toggles.length === 0) {
        // 还没格式化，先尝试格式化再折叠
        const t = requireText()
        if (t == null) return
        try {
          const parsed = JSON.parse(t)
          renderJSON(parsed)
        } catch (e) {
          setStatus(parseError(e, t), 'err')
          return
        }
      }
      editor
        .querySelectorAll<HTMLElement>('.fold-toggle[data-collapsed="false"]')
        .forEach((t) => setFolded(t, true))
      applyFolds()
      setStatus('✓ 已折叠全部节点', 'ok')
    },
    async copy() {
      const text = getRawText()
      if (!text) {
        setStatus('编辑器为空，没有可复制的内容', 'err')
        return
      }
      try {
        await navigator.clipboard.writeText(text)
        setStatus('✓ 已复制到剪贴板', 'ok')
      } catch {
        setStatus('✗ 复制失败，请手动选择文本复制', 'err')
      }
    },
    download() {
      const text = getRawText()
      if (!text) {
        setStatus('编辑器为空，没有可下载的内容', 'err')
        return
      }
      const blob = new Blob([text], { type: 'application/json;charset=utf-8' })
      const a = document.createElement('a')
      a.href = URL.createObjectURL(blob)
      a.download = `data-${Date.now()}.json`
      a.click()
      URL.revokeObjectURL(a.href)
      setStatus('✓ 已开始下载', 'ok')
    },
    clear() {
      editor.replaceChildren()
      setStatus('已清空', 'info')
      updateStats()
      editor.focus()
    },
  }

  document.querySelectorAll<HTMLButtonElement>('[data-act]').forEach((b) => {
    b.addEventListener('click', () => actions[b.dataset.act!]?.())
  })

  // 快捷键：Ctrl/⌘+Enter 一键格式化
  editor.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
      e.preventDefault()
      actions.format()
    }
  })
</script>
