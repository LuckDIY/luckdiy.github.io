---
import Layout from '~/layouts/Layout.astro'
import PageHeader from '~/components/PageHeader.astro'

const tools = [
  {
    name: 'JSON 格式化',
    description: '美化、压缩、校验 JSON 数据',
    url: '/tools/json',
  },
  {
    name: 'Base64 编解码',
    description: '文本与 Base64 互转，支持 UTF-8',
    url: '/tools/base64',
  },
]
---

<Layout title="工具箱" description="常用在线小工具集合">
  <PageHeader title="tools" />
  <section class="mt-6 grid gap-4 sm:grid-cols-2">
    {
      tools.map((tool) => (
        <a
          href={tool.url}
          class="block border-1 border-accent/30 rounded-xl px-4 py-3 no-underline hover:bg-accent/8 transition-colors"
        >
          <div class="text-accent text-lg font-semibold">{tool.name}</div>
          <div class="text-foreground/70 text-sm mt-1">{tool.description}</div>
        </a>
      ))
    }
  </section>
</Layout>